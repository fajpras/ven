APP_NAME=VEN
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Kunci enkripsi AES-256-GCM untuk kolom sensitif (mis. google_id).
# WAJIB diisi nilai acak minimal 32 karakter. Jangan commit nilai asli.
VEN_CUSTOM_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ven
VEN_DB_CLIENT_HOST=localhost

DB_LOG_CONNECTION=mysql

# akun aplikasi
DB_APP_USERNAME=ven
DB_APP_PASSWORD=123

# akun pengguna
DB_USER_USERNAME=ven_user
DB_USER_PASSWORD=123

# akun admin
DB_ADMIN_USERNAME=ven_admin
DB_ADMIN_PASSWORD=123

# akun administrasi
DB_DBA_USERNAME=ven_dba
DB_DBA_PASSWORD=123

# akun root
# MYSQL_ROOT_USER=root

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_EXPIRATION=43200

# Google OAuth Web Client ID (Google Cloud Console -> Credentials -> Web application)
GOOGLE_CLIENT_ID=
# Google OAuth Client Secret (Web application credentials)
GOOGLE_CLIENT_SECRET=
# URL callback OAuth backend
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
# Daftar Client ID valid verifikasi token (Web / Android). Pisahkan koma jika lebih dari satu.
GOOGLE_CLIENT_IDS=

LIVEKIT_URL=wss://livekit.domain-anda.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

AI_KEY=
AI_URL=
AI_MODEL=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@domain-anda.com
MAIL_FROM_NAME="${APP_NAME}"
