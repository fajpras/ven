# ==============================================================================
# VEN BACKEND API - ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi lokal/server.
# ==============================================================================

# --- APLIKASI UTAMA ---
APP_NAME=VEN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- ENKRIPSI SISTEM (AES-256-GCM) ---
# Kunci enkripsi kustom untuk data sensitif (misalnya Google ID) dan Blind Index.
# WAJIB diisi string acak minimal 32 karakter (atau base64 32 bytes). Jangan commit kunci asli!
VEN_CUSTOM_KEY=

# --- KONEKSI BASIS DATA (MULTI-ROLE LEAST PRIVILEGE) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ven
VEN_DB_CLIENT_HOST=localhost
DB_LOG_CONNECTION=mysql

# Akun Aplikasi (Least Privilege - Operasional Normal)
DB_APP_USERNAME=ven
DB_APP_PASSWORD=secret

# Akun Pengguna (Akses R/W Data Pengguna & Konten)
DB_USER_USERNAME=ven_user
DB_USER_PASSWORD=secret

# Akun Administrator (Moderasi, Log Keamanan & Sanksi)
DB_ADMIN_USERNAME=ven_admin
DB_ADMIN_PASSWORD=secret

# Akun DBA (Pencadangan, Pemulihan & Migrasi Skema)
DB_DBA_USERNAME=ven_dba
DB_DBA_PASSWORD=secret

# --- CADANGAN & PEMULIHAN (BACKUP & RESTORE) ---
# Kosongkan untuk menggunakan default storage lokal: storage/app/backups
BACKUP_PATH=

# --- DRIVER SISTEM ---
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- AUTENTIKASI SANCTUM ---
# Masa berlaku token API dalam menit (43200 menit = 30 hari)
SANCTUM_EXPIRATION=43200

# --- GOOGLE OAUTH ---
# Google OAuth Web Client ID (Google Cloud Console -> Credentials -> Web application)
GOOGLE_CLIENT_ID=
# Google OAuth Client Secret (Web application credentials)
GOOGLE_CLIENT_SECRET=
# URL callback OAuth backend
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
# Daftar Client ID valid verifikasi token (Web / Android). Pisahkan koma jika lebih dari satu.
GOOGLE_CLIENT_IDS=

# --- LIVEKIT WEBRTC ---
LIVEKIT_URL=wss://livekit.domain-anda.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- INTEGRASI GOOGLE AI STUDIO (GEMINI) ---
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
# Kosongkan AI_URL untuk menggunakan endpoint resmi Google AI Studio secara default
AI_URL=

# --- PENGIRIMAN EMAIL (SMTP & OTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@ven.test"
MAIL_FROM_NAME="${APP_NAME}"
